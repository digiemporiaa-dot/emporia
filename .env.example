# Copy to .env and fill in. Never commit real values.
# Every key the application reads is listed here; lib/config/env.ts is the only
# module that reads process.env, and it validates this list at boot.

# --- Required ---------------------------------------------------------------
DATABASE_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=
# Public origin, used to derive canonical URLs.
SITE_URL=

# --- Optional: logging ------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=

# --- Optional: email (Phase 12) --------------------------------------------
# Absent means "not configured": sends raise a typed error rather than
# pretending to succeed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# --- Optional: storage, Cloudflare R2 (Phase 11) ---------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: overrides the endpoint derived from R2_ACCOUNT_ID (jurisdiction-
# specific endpoints, or a local S3-compatible server).
R2_ENDPOINT=

# --- Optional: payments, Razorpay (Phase 13) -------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: shipping, Shiprocket (interface only) -----------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Optional: AI (Phase 16) ------------------------------------------------
AI_PROVIDER=
AI_API_KEY=

# --- Seeding ----------------------------------------------------------------
# Read by `npm run db:seed` to create the first super admin. Credentials are
# never hardcoded. Omit these and the seed skips user creation.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# --- Tests ------------------------------------------------------------------
# A separate database, so a test run can never touch development data.
TEST_DATABASE_URL=
