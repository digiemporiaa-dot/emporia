model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProjectTask?  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks ProjectTask[] @relation("TaskSubtasks")

  title       String
  description String?

  assigneeId String?
  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)
  dueAt    DateTime?

  // Hours worked/estimated, not money — Decimal for fractional precision.
  estimateHours Decimal? @db.Decimal(8, 2)

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencies ProjectTaskDependency[] @relation("DependentTask")
  dependents   ProjectTaskDependency[] @relation("DependsOnTask")
  comments     ProjectComment[]
  timeEntries  TimeEntry[]

  @@index([projectId, status])
  @@index([assigneeId, dueAt])
  @@index([parentId])
  @@index([milestoneId])
}

model ProjectTaskDependency {
  taskId      String
  task        ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   ProjectTask @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model ProjectMilestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime
  status    MilestoneStatus @default(PENDING)
  order     Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks ProjectTask[]

  @@index([projectId, order])
}

model ProjectComment {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      ProjectTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([authorId])
}

model TimeEntry {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  minutes   Int
  note      String?
  startedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([projectId])
  @@index([taskId])
}

model ContentCalendarItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Denormalised from the project on purpose: this is the column portal
  // isolation filters on, and it must not depend on a join being written
  // correctly at every call site.
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  channel ContentChannel
  title   String
  brief   String?
  stage   ContentStage   @default(IDEA)

  scheduledFor DateTime?
  publishedAt  DateTime?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  mediaId String?
  media   Media?  @relation("ContentItemMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  // The editorial campaign this belongs to — "Diwali 2026". A Campaign, not a
  // second campaign model: `SOCIAL_ORGANIC` is a real platform value, a budget
  // of zero is accurate for organic work, and Lead.campaignId already points
  // here, so social work reaches revenue through the attribution the CRM
  // already records (docs/SOCIAL-MODULE.md 2).
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Which of the client's content pillars this serves ("Product education").
  /// Nulled, not cascaded, when a pillar is deleted: the idea outlives the
  /// label. Must belong to the same client — checked in the service.
  pillarId String?
  pillar   ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)

  /// The article this idea was repurposed from, when it came from one of the
  /// site's own blog posts. Nulled if the article is deleted.
  sourceBlogPostId String?
  sourceBlogPost   BlogPost? @relation("ContentFromBlogPost", fields: [sourceBlogPostId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals       Approval[]
  socialPosts     SocialPost[]
  internalReviews SocialInternalReview[]

  @@index([clientId, stage])
  @@index([campaignId])
  @@index([pillarId])
  @@index([sourceBlogPostId])
  @@index([scheduledFor])
  @@index([projectId])
  @@index([ownerId])
  @@index([mediaId])
}

model Approval {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId     String?
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contentItemId String?
  contentItem   ContentCalendarItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  title          String
  status         ApprovalStatus @default(PENDING)
  currentVersion Int            @default(1)

  requestedById String
  requestedBy   User      @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?     @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ApprovalVersion[]

  @@index([clientId, status])
  @@index([projectId])
  @@index([contentItemId])
  @@index([requestedById])
}

enum SocialReportStatus {
  DRAFT
  PUBLISHED
}

/// A client's monthly social report, frozen when generated.
///
/// `data` is a snapshot of stored metrics at generation time (shape:
/// `socialReportDataSchema`), so a report the client has read does not change
/// under them when a late snapshot arrives. Figures come only from stored
/// rows; `notes` is the one human-written part.
model SocialReport {
  id       String             @id @default(cuid())
  clientId String
  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// `YYYY-MM`, in the calendar's time zone.
  month    String
  status   SocialReportStatus @default(DRAFT)
  data     Json
  notes    String?

  generatedById String
  generatedBy   User      @relation("SocialReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  generatedAt   DateTime  @default(now())
  publishedById String?
  publishedBy   User?     @relation("SocialReportPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month])
  @@index([clientId, status])
  @@index([generatedById])
  @@index([publishedById])
}

/// One round of internal (agency) review on a social content item.
///
/// Kept apart from `Approval` on purpose: approvals are what the client sees
/// and decides in the portal, and an internal round must never appear there.
/// Rounds are never overwritten — each carries a frozen snapshot of what was
/// submitted, so "approved internally" always names exactly what was approved.
model SocialInternalReview {
  id            String              @id @default(cuid())
  contentItemId String
  contentItem   ContentCalendarItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  round         Int

  status   InternalReviewStatus @default(PENDING)
  /// What the submitter asked the reviewer to look at.
  note     String?
  /// What the reviewer said. Required for changes requested and rejected.
  feedback String?
  /// The platform versions as submitted — same shape as an approval snapshot.
  snapshot Json

  submittedById String
  submittedBy   User      @relation("InternalReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime  @default(now())
  reviewerId    String?
  reviewer      User?     @relation("InternalReviewDecidedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  decidedAt     DateTime?

  @@unique([contentItemId, round])
  @@index([clientId, status])
  @@index([submittedById])
  @@index([reviewerId])
}

model ApprovalVersion {
  id         String   @id @default(cuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  version    Int

  mediaId String?
  media   Media?  @relation("ApprovalVersionMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  notes    String?
  status   ApprovalStatus @default(PENDING)
  feedback String?

  /// What the client was actually shown, frozen at the moment the version was
  /// sent. A creative approval used to be one file and a note; a social
  /// approval is several platform versions, each with its own caption. Without
  /// a copy here, "approved" only ever means "approved something", because the
  /// live posts can be edited afterwards. Shape is validated by
  /// `socialSnapshotSchema` on write and parsed on read.
  snapshot Json?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([approvalId, version])
  @@index([mediaId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Campaign {
  id       String  @id @default(cuid())
  name     String
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  platform  CampaignPlatform
  objective String?

  budget   Decimal  @default(0) @db.Decimal(14, 2)
  currency Currency @default(INR)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  status   CampaignStatus @default(DRAFT)
  startsAt DateTime
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics      CampaignMetric[]
  leads        Lead[]
  popupEvents  PopupAnalytics[]
  contentItems ContentCalendarItem[]

  @@index([clientId, status])
  @@index([ownerId])
  @@index([platform, status])
}

// Numbers are entered by staff or imported from a provider. Nothing else
// writes here — CLAUDE.md 2 rule 5 and 16 forbid fabricated campaign metrics,
// and `source` keeps provenance auditable rather than assumed.
model CampaignMetric {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  revenue     Decimal? @db.Decimal(14, 2)

  source MetricSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

model UTMTracking {
  id        String @id @default(cuid())
  visitorId String

  source   String?
  medium   String?
  campaign String?
  term     String?
  content  String?

  landingPath String?
  referrer    String?
  device      DeviceType       @default(DESKTOP)
  touch       AttributionTouch

  occurredAt DateTime @default(now())

  firstTouchLeads Lead[]           @relation("LeadFirstTouch")
  lastTouchLeads  Lead[]           @relation("LeadLastTouch")
  popupEvents     PopupAnalytics[]

  @@index([visitorId, occurredAt])
  @@index([source, medium])
  @@index([touch])
}

model Popup {
  id         String  @id @default(cuid())
  name       String
  title      String
  body       String?
  ctaLabel   String?
  ctaHref    String?
  // Field definitions for the capture form, validated server-side on submit.
  formFields Json?

  trigger      PopupTrigger   @default(TIME_DELAY)
  // Seconds for TIME_DELAY, percent for SCROLL_PERCENT, else null.
  triggerValue Int?
  frequency    PopupFrequency @default(ONCE_PER_SESSION)
  priority     Int            @default(0)

  isActive Boolean   @default(false)
  startsAt DateTime?
  endsAt   DateTime?

  mediaId String?
  media   Media?  @relation("PopupMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets   PopupTarget[]
  analytics PopupAnalytics[]
  leads     Lead[]

  @@index([isActive, priority])
  @@index([mediaId])
}

model PopupTarget {
  id      String          @id @default(cuid())
  popupId String
  popup   Popup           @relation(fields: [popupId], references: [id], onDelete: Cascade)
  type    PopupTargetType

  path              String?
  serviceId         String?
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cityId            String?
  city              City?            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  serviceCityPageId String?
  serviceCityPage   ServiceCityPage? @relation(fields: [serviceCityPageId], references: [id], onDelete: Cascade)
  packageId         String?
  package           ServicePackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  visitorType VisitorType @default(ANY)
  device      DeviceType  @default(ANY)

  createdAt DateTime @default(now())

  @@index([popupId])
  @@index([serviceId])
  @@index([cityId])
  @@index([serviceCityPageId])
  @@index([packageId])
}

model PopupAnalytics {
  id      String         @id @default(cuid())
  popupId String
  popup   Popup          @relation(fields: [popupId], references: [id], onDelete: Cascade)
  event   PopupEventType

  visitorId String
  path      String

  serviceId  String?
  service    Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cityId     String?
  city       City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmId      String?
  utm        UTMTracking? @relation(fields: [utmId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())

  @@index([popupId, event, occurredAt])
  @@index([visitorId])
  @@index([serviceId])
  @@index([cityId])
  @@index([campaignId])
  @@index([utmId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Invoice {
  id       String @id @default(cuid())
  number   String @unique
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  retainerId String?
  retainer   Retainer? @relation(fields: [retainerId], references: [id], onDelete: SetNull)

  status   InvoiceStatus @default(DRAFT)
  currency Currency      @default(INR)

  issuedAt DateTime @default(now())
  dueAt    DateTime

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  paidTotal     Decimal @default(0) @db.Decimal(14, 2)
  // Stored and recomputed inside the same transaction as every payment, so
  // overdue queries are an indexed scan rather than an aggregate over Payment.
  dueTotal      Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([deletedAt])
  @@index([projectId])
  @@index([contractId])
  @@index([retainerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?

  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  discountRate Decimal @default(0) @db.Decimal(6, 3)
  taxRate      Decimal @default(0) @db.Decimal(6, 3)
  lineTotal    Decimal @db.Decimal(14, 2)

  order Int @default(0)

  @@index([invoiceId, order])
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  amount   Decimal  @db.Decimal(14, 2)
  currency Currency @default(INR)

  gateway PaymentGateway @default(RAZORPAY)
  status  PaymentStatus  @default(PENDING)

  gatewayOrderId   String?
  // Unique constraints are how a replayed webhook fails to double-credit —
  // enforced by the database, not by logic that could race
  // (docs/ARCHITECTURE.md 6.7).
  gatewayPaymentId String? @unique
  gatewaySignature String?
  idempotencyKey   String  @unique

  rawPayload Json?
  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([clientId, status])
  @@index([gatewayOrderId])
}

model Retainer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  name     String
  amount   Decimal  @db.Decimal(14, 2)
  currency Currency @default(INR)

  cycle  BillingCycle   @default(MONTHLY)
  status RetainerStatus @default(ACTIVE)

  startsAt      DateTime
  nextBillingAt DateTime
  endsAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([status, nextBillingAt])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Media {
  id  String @id @default(cuid())
  // Opaque object key generated server-side. Never derived from the client
  // filename (CLAUDE.md 11).
  key String @unique
  url String

  filename String
  mimeType String
  size     Int
  type     MediaType
  width    Int?
  height   Int?
  alt      String?
  checksum String?

  /// A human title, distinct from the filename. The filename is what landed in
  /// the bucket; this is what an editor calls the picture.
  title String?

  /// Default caption. Used where a block shows one and has none of its own, so
  /// a photo credit set once follows the image everywhere it appears.
  caption String?

  /// Internal notes — where the shot came from, what the licence is, who is in
  /// it. Never rendered publicly.
  description String?

  /// Focal point, as whole percentages of width and height (0-100).
  ///
  /// A cropped image loses its edges, and which edges matter is a property of
  /// the picture, not of the band it is placed in: a portrait needs its face
  /// kept whatever aspect ratio it is poured into. Null means centre, which is
  /// what every image did before this existed.
  focalX Int?
  focalY Int?

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions           MediaVersion[]
  userAvatars        User[]                @relation("UserAvatar")
  serviceHeroes      Service[]             @relation("ServiceHero")
  blogCovers         BlogPost[]            @relation("BlogCover")
  caseStudyCovers    CaseStudy[]           @relation("CaseStudyCover")
  testimonialAvatars Testimonial[]         @relation("TestimonialAvatar")
  clientLogos        Client[]              @relation("ClientLogo")
  contractDocs       Contract[]            @relation("ContractDocument")
  contentItems       ContentCalendarItem[] @relation("ContentItemMedia")
  approvalVersions   ApprovalVersion[]     @relation("ApprovalVersionMedia")
  popups             Popup[]               @relation("PopupMedia")
  seoOgImages        Seo[]                 @relation("SeoOgImage")
  seoTwitterImages   Seo[]                 @relation("SeoTwitterImage")

  tags MediaTag[]

  socialAccountAvatars SocialAccount[]   @relation("SocialAccountAvatar")
  socialPostMedia      SocialPostMedia[] @relation("SocialPostMedia")
  socialPostThumbnails SocialPostMedia[] @relation("SocialPostThumbnail")

  @@index([folderId])
  @@index([type])
  @@index([deletedAt])
  @@index([uploadedById])
}

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")
  path     String        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]

  @@index([parentId])
}

model MediaVersion {
  id      String @id @default(cuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  version Int
  key     String
  url     String
  size    Int

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@unique([mediaId, version])
  @@index([uploadedById])
}

model EmailTemplate {
  id        String           @id @default(cuid())
  key       EmailTemplateKey @unique
  name      String
  subject   String
  html      String
  text      String?
  // Declared substitution variables, for admin editing and validation.
  variables Json?
  isActive  Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id                String            @id @default(cuid())
  templateKey       EmailTemplateKey?
  to                String
  cc                String?
  subject           String
  status            EmailStatus       @default(QUEUED)
  error             String?
  providerMessageId String?

  /// The values the template was rendered with, so a retry sends the same mail
  /// rather than one full of unfilled placeholders.
  variables Json?

  entityType String?
  entityId   String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([to])
  @@index([entityType, entityId])
}

model Notification {
  id      String              @id @default(cuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel @default(IN_APP)

  title String
  body  String?
  href  String?

  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Automation {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers   AutomationTrigger[]
  conditions AutomationCondition[]
  actions    AutomationAction[]

  @@index([isActive, order])
}

model AutomationTrigger {
  id           String                @id @default(cuid())
  automationId String
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         AutomationTriggerType
  config       Json?

  @@index([automationId])
  @@index([type])
}

model AutomationCondition {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  field        String
  operator     String
  value        Json
  order        Int        @default(0)

  @@index([automationId, order])
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String
  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         AutomationActionType
  config       Json
  order        Int                  @default(0)

  @@index([automationId, order])
}

// Written inside the same transaction as the mutation it records, so an audit
// gap cannot outlive a successful write (docs/ARCHITECTURE.md 4.5).
model AuditLog {
  id      String      @id @default(cuid())
  actorId String?
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action  AuditAction

  entityType String
  entityId   String

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// One reusable SEO record. The owning entity holds a unique FK to it, so every
// link is a real foreign key with real cascade behaviour — never a polymorphic
// entityType/entityId pair (docs/ARCHITECTURE.md 4.4).
model Seo {
  id String @id @default(cuid())

  metaTitle       String?
  metaDescription String?
  canonical       String?

  /// The phrase this page is meant to rank for.
  ///
  /// One, deliberately. A page written for six keywords ranks for none, and
  /// the analyzer can only say something useful about presence and density if
  /// it knows which phrase to look for. Blank means the checks that need one
  /// are simply not run — an unanswered question, not a failure.
  targetKeyword String?

  ogTitle       String?
  ogDescription String?
  ogImageId     String?
  ogImage       Media?  @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  ogImageAlt    String?

  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?
  twitterImage       Media?  @relation("SeoTwitterImage", fields: [twitterImageId], references: [id], onDelete: SetNull)

  robotsIndex  Boolean    @default(true)
  robotsFollow Boolean    @default(true)
  schemaType   SchemaType @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service         Service?         @relation("ServiceSeo")
  city            City?            @relation("CitySeo")
  serviceCityPage ServiceCityPage? @relation("ServiceCityPageSeo")
  page            Page?            @relation("PageSeo")
  blogPost        BlogPost?        @relation("BlogPostSeo")
  blogCategory    BlogCategory?    @relation("BlogCategorySeo")
  caseStudy       CaseStudy?       @relation("CaseStudySeo")
  servicePackage  ServicePackage?  @relation("ServicePackageSeo")

  @@index([ogImageId])
  @@index([twitterImageId])
}

// Loop detection runs at write time, not request time — a cycle never reaches
// production data (docs/ARCHITECTURE.md 12.4).
model Redirect {
  id       String       @id @default(cuid())
  fromPath String       @unique
  toPath   String
  type     RedirectType @default(PERMANENT_301)
  isActive Boolean      @default(true)

  hits      Int       @default(0)
  lastHitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  group String @default("general")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// Non-secret configuration only. Credentials live in env and are read solely
// through lib/config (CLAUDE.md 2 rule 6).
/// Fixed-window rate limiting, shared across application instances.
///
/// In-process counters are correct for exactly one container: behind two, an
/// attacker gets the limit once per instance. The window lives here so the
/// limit is the limit however many instances are running (docs/ARCHITECTURE.md
/// 19 D9).
model RateLimitWindow {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model IntegrationSetting {
  id        String  @id @default(cuid())
  provider  String  @unique
  config    Json
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Social media
//
// One content idea lives in a ContentCalendarItem — the model the delivery
// calendar, the approval workflow and the client portal already use. What is
// new below is everything platform-specific: the accounts a client has
// connected, the per-platform version of a post, each attempt to publish one,
// and the metrics that come back afterwards.
//
// Client isolation is by direct column. Every table here carries `clientId`
// rather than deriving it through two joins, because the query that has to be
// right every single time is the one that filters by it.
// ---------------------------------------------------------------------------

enum SocialProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  X
  GOOGLE_BUSINESS_PROFILE
}

enum SocialAccountStatus {
  /// Credentials held and working.
  CONNECTED
  /// Held but rejected by the provider — expired, revoked, or scope changed.
  NEEDS_RECONNECT
  /// Deliberately disconnected. The row is kept so published history survives.
  DISCONNECTED
}

/// What a post is, across every provider. Which of these a given provider
/// accepts is declared by its adapter, never assumed.
enum SocialPostType {
  SINGLE_IMAGE
  CAROUSEL
  VIDEO
  REEL
  STORY
  TEXT
  LINK
  YOUTUBE_VIDEO
  YOUTUBE_SHORT
  GBP_POST
}

enum SocialPostStatus {
  DRAFT
  /// Approved and waiting for its scheduled time.
  SCHEDULED
  /// Claimed by a scheduler run. Nothing else may claim it.
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PublicationStatus {
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// A platform account a client has connected.
///
/// The token itself is never a column anyone can read casually: it is
/// encrypted with the same AES-256-GCM helper the AI key and the Meta
/// Conversions token use (lib/security/secret.ts), and no service returns it.
model SocialAccount {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  provider SocialProvider

  /// The provider's own id for the account. Unique per provider: the same
  /// Instagram account cannot be connected to two clients at once, which would
  /// make "whose post is this" unanswerable.
  externalId       String
  /// What the provider needs alongside `externalId` to address the account,
  /// where one id is not enough: a Business Profile location is posted to
  /// through the Google account that manages it. Null for everything else.
  externalParentId String?
  name             String
  username         String?
  profileUrl       String?

  avatarId String?
  avatar   Media?  @relation("SocialAccountAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  status SocialAccountStatus @default(CONNECTED)

  /// Encrypted. Read only by the provider adapter, never returned by a service.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  /// The `tokenExpiresAt` people were last warned about. Keyed on the value, not
  /// a flag, so a reconnection (a new expiry) warns again and a repeat cron run
  /// for the same expiry does not.
  expiryWarnedFor DateTime?
  /// The scopes the provider actually granted, so a missing permission is a
  /// diagnosable state rather than a mystery failure at publish time. Only
  /// what the platform reported — never the list that was requested.
  scopes           String[]  @default([])
  /// When the platform last reported `scopes`. Null means it has not said, so
  /// an empty list reads as "not reported" rather than "granted nothing".
  scopesReportedAt DateTime?

  lastSyncedAt  DateTime?
  /// The last check, successful or not. The scheduled check waits a retry gap
  /// after a failed one rather than asking again every cron run.
  lastCheckAttemptAt DateTime?
  lastSyncError String?
  /// Consecutive failures. Reset on success; used to surface a failing account
  /// before somebody notices their posts stopped going out.
  failureCount  Int       @default(0)

  connectedById String?
  connectedBy   User?   @relation("SocialAccountConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts SocialPost[]

  @@unique([provider, externalId])
  @@index([clientId, status])
  @@index([provider, status])
  @@index([avatarId])
  @@index([connectedById])
}

/// A sign-in that can reach several accounts, waiting for the operator to say
/// which one this client means.
///
/// One Facebook login manages many Pages; one Google login many business
/// locations. The OAuth callback cannot guess, so it parks the grant here and
/// sends the operator to a picker. Only the user-level token is kept, encrypted,
/// for a few minutes; the Page or location token is fetched at the moment of
/// choosing and goes straight onto the SocialAccount, never through the browser.
model SocialPendingConnection {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  provider SocialProvider

  /// Only the operator who signed in may finish it: the grant is their login.
  startedById String
  startedBy   User   @relation(fields: [startedById], references: [id], onDelete: Cascade)

  /// Encrypted JSON of the user-level credentials. Never returned by a service.
  credentials String
  /// What the picker shows: id, name, username, profile URL. Never a token.
  options     Json
  returnTo    String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([startedById])
  @@index([expiresAt])
}

/// How a client sounds and what it will not say: the brief every caption is
/// written against, by a person or by the AI assistant.
///
/// One per client. Everything is optional — an agency fills it in over time,
/// and a half-written profile is still better than none.
model SocialBrandProfile {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// What the brand calls itself in copy, where it differs from the client's
  /// legal name ("Northwind" for "Northwind Technologies Pvt Ltd").
  brandName         String?
  tone              String?
  industry          String?
  targetAudience    String?
  preferredLanguage String?
  ctaStyle          String?
  /// Hex values, for the designer; not used to generate anything.
  brandColors       String[] @default([])
  /// Always-on hashtags, stored without the leading #.
  hashtags          String[] @default([])
  /// Words and phrases the brand never uses. Checked against AI drafts.
  forbiddenWords    String[] @default([])
  preferredEmojis   String[] @default([])
  postingRules      String?

  updatedById String?
  updatedBy   User?   @relation("SocialBrandProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

/// A recurring theme a client's content is built around ("Customer stories").
/// Content items point at one; the calendar filters by it.
model ContentPillar {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Display order in pickers and the strategy page.
  position    Int       @default(0)
  /// Archived pillars keep their content's history but are no longer offered.
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ContentCalendarItem[]

  @@unique([clientId, name])
  @@index([clientId, archivedAt])
}

/// What the agency has agreed to do for a client on social, and what it is
/// aiming at. Targets only: nothing here is ever marked "achieved" — the
/// dashboards compare against stored numbers where they exist, and say so
/// where they do not.
model SocialStrategy {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  objectives       String?
  platforms        SocialProvider[] @default([])
  /// Planned posts per week, per platform: `{ "INSTAGRAM": 4, "LINKEDIN": 2 }`.
  /// Validated in the service against `SocialProvider`.
  postingFrequency Json             @default("{}")
  campaignGoals    String?
  /// `[{ metric, target, period }]` — targets as agreed with the client.
  kpiTargets       Json             @default("[]")

  updatedById String?
  updatedBy   User?   @relation("SocialStrategyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

enum OccasionCategory {
  FESTIVAL
  NATIONAL_DAY
  AWARENESS_DAY
  INDUSTRY_EVENT
  BRAND
}

/// A day content can be planned around: a festival, a national day, an
/// industry event, a brand's anniversary.
///
/// The library is agency-wide (`clientId` null); a client can also have its
/// own occasions (a brand anniversary). A fixed-date occasion recurs on
/// `fixedMonth`/`fixedDay` every year. A moving one — Diwali, Holi, Eid —
/// has a row in `ContentOccasionDate` per year, entered by a person: dates
/// that depend on a lunar calendar or a moon sighting are never computed or
/// guessed here, and an occasion without a date for a year simply does not
/// appear in that year.
///
/// Nothing here ever creates or publishes content. It is a planning aid.
model ContentOccasion {
  id       String  @id @default(cuid())
  /// Null for the agency-wide library; set for a client's own occasion.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  slug        String           @unique
  name        String
  category    OccasionCategory
  description String?
  fixedMonth  Int?
  fixedDay    Int?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dates   ContentOccasionDate[]
  choices ClientOccasion[]

  @@index([clientId, archivedAt])
}

/// One year's date for a moving occasion.
model ContentOccasionDate {
  id         String          @id @default(cuid())
  occasionId String
  occasion   ContentOccasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  /// The calendar day, stored at 00:00 UTC; read as a date, never a moment.
  date       DateTime        @db.Date

  createdAt DateTime @default(now())

  @@unique([occasionId, date])
  @@index([date])
}

/// A client opting in to a library occasion. Absent means not opted in:
/// nothing appears on a client's calendar unless someone chose it.
model ClientOccasion {
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   ContentOccasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([clientId, occasionId])
  @@index([occasionId])
}

/// One platform's version of one content idea.
///
/// The reason this model exists: the same idea reads differently on Instagram,
/// LinkedIn and a Google Business Profile, and forcing one caption onto all of
/// them is the thing agencies most complain about in scheduling tools.
model SocialPost {
  id String @id @default(cuid())

  contentItemId String
  contentItem   ContentCalendarItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  /// Denormalised from the content item, exactly as the item denormalises it
  /// from its project: this is the column every isolation check filters on.
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId String?
  account   SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  provider SocialProvider
  type     SocialPostType
  status   SocialPostStatus @default(DRAFT)

  // Copy. Which fields a provider actually uses is its adapter's business; the
  // editor only shows the ones that provider supports.
  caption      String?
  headline     String?
  hashtags     String[] @default([])
  mentions     String[] @default([])
  callToAction String?
  /// Posted as a reply immediately after publication, where the provider
  /// supports it — the usual home for hashtags on LinkedIn and Instagram.
  firstComment String?
  linkUrl      String?

  /// UTM values applied to `linkUrl` at publication. Stored so the link that
  /// went out can be reconstructed, and so attribution is server-side.
  utmCampaign String?
  utmContent  String?

  scheduledFor DateTime?
  publishedAt  DateTime?

  externalPostId String?
  externalUrl    String?

  /// The last failure, in words a person can act on.
  lastError     String?
  /// The last attempt may have reached the platform even though it did not
  /// confirm. Nothing — not the scheduler, not a bulk retry, not Publish now —
  /// may send this post again until a person has looked at the platform and
  /// said whether it went out. Cleared by that resolution or by a success.
  ambiguous     Boolean   @default(false)
  lastAttemptAt DateTime?
  attemptCount  Int       @default(0)
  /// Set when the AI wrote this version and no person has saved it since.
  /// Shown as "AI draft", and such a version cannot be sent to the client:
  /// every AI result is a draft until a person has put their name to it.
  aiDraftedAt   DateTime?

  /// Ordering within a content item, so the editor lists versions predictably.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media        SocialPostMedia[]
  publications SocialPublication[]
  metrics      SocialMetricSnapshot[]

  /// Joined against a lead's `utm_content` to trace the lead to this post.
  @@index([utmContent])
  @@index([clientId, status])
  @@index([contentItemId])
  @@index([accountId])
  @@index([status, scheduledFor])
  @@index([provider, publishedAt])
  /// The calendar's query: one client, one date window. The scheduler's
  /// [status, scheduledFor] index does not serve it, because the calendar
  /// wants every status within a month rather than one status across all time.
  @@index([clientId, scheduledFor])
}

/// Creatives attached to a post, in order — a carousel is this table with
/// several rows. Media is referenced, never copied (CLAUDE.md 3: the app
/// server filesystem is never permanent storage).
model SocialPostMedia {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation("SocialPostMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  /// A video's poster frame, where the provider takes one.
  thumbnailId String?
  thumbnail   Media?  @relation("SocialPostThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  order Int @default(0)

  createdAt DateTime @default(now())

  @@unique([postId, order])
  @@index([mediaId])
  @@index([thumbnailId])
}

/// One attempt to publish one post.
///
/// A row per attempt rather than a counter on the post, because a retry needs
/// the previous failure's provider error to be diagnosable, and because the
/// idempotency key has to live on the attempt for a duplicate scheduler run to
/// collide with it rather than publish twice.
model SocialPublication {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  provider SocialProvider
  status   PublicationStatus @default(QUEUED)

  /// Unique. This is what makes publication idempotent: a second scheduler
  /// run, a retried request and a replayed webhook all derive the same key and
  /// the second insert fails instead of posting again.
  idempotencyKey String @unique

  attempt     Int       @default(1)
  attemptedAt DateTime  @default(now())
  completedAt DateTime?

  externalPostId String?
  externalUrl    String?

  /// Human-readable, for the screen. The provider's raw response is logged
  /// server-side, not stored here — it can carry tokens.
  error String?

  triggeredById String?
  triggeredBy   User?   @relation("SocialPublicationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([postId, attempt])
  @@index([clientId, status])
  @@index([status, attemptedAt])
  @@index([triggeredById])
}

/// A day's metrics for a published post.
///
/// Every figure is nullable, and that is the point: no provider reports all of
/// these, and a zero where a platform reports nothing is a fabricated metric
/// (CLAUDE.md 2 rule 5). One row per post per day, so trends are a query
/// rather than a guess.
model SocialMetricSnapshot {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  capturedOn DateTime @db.Date

  reach            Int?
  impressions      Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  clicks           Int?
  videoViews       Int?
  watchTimeSeconds Int?
  profileVisits    Int?
  followersGained  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, capturedOn])
  @@index([clientId, capturedOn])
}
