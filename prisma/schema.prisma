  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  title  String
  status ContractStatus @default(DRAFT)

  value    Decimal  @db.Decimal(14, 2)
  currency Currency @default(INR)

  startsAt DateTime
  endsAt   DateTime?
  terms    String?

  documentId String?
  document   Media?  @relation("ContractDocument", fields: [documentId], references: [id], onDelete: SetNull)

  signedAt  DateTime?
  renewalAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  invoices Invoice[]

  @@index([status])
  @@index([clientId])
  @@index([proposalId])
  @@index([documentId])
}

model Client {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
