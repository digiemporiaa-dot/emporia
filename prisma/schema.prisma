  IMPORT
}

enum PopupTrigger {
  PAGE_LOAD
  TIME_DELAY
  SCROLL_PERCENT
  EXIT_INTENT
  BUTTON_CLICK
}

enum PopupFrequency {
  EVERY_VISIT
  ONCE_PER_SESSION
  ONCE_PER_DAY
  ONCE_PER_WEEK
  ONCE_PER_USER
}

enum PopupTargetType {
  GLOBAL
  PAGE
  SERVICE
  CITY
  SERVICE_CITY
  PACKAGE
}

enum PopupEventType {
  IMPRESSION
  VIEW
  FORM_START
  SUBMISSION
  CONVERSION
}

enum VisitorType {
  NEW
  RETURNING
  ANY
}

enum DeviceType {
  DESKTOP
  TABLET
  MOBILE
  ANY
}

enum AttributionTouch {
  FIRST
  LAST
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum EmailTemplateKey {
  NEW_LEAD
  LEAD_ASSIGNED
  FOLLOW_UP
  STAFF_INVITATION
  PASSWORD_RESET
  PROPOSAL_SENT
  PROPOSAL_ACCEPTED
  INVOICE_SENT
  PAYMENT_RECEIVED
  PAYMENT_REMINDER
  CLIENT_NOTIFICATION
}

// WHATSAPP / SMS / PUSH are architected only (CLAUDE.md 3). Selecting one
// raises a typed "channel not configured" error — never a silent success.
enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum AutomationTriggerType {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_ASSIGNED
  PROPOSAL_SENT
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  INVOICE_SENT
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  PROJECT_CREATED
  TASK_OVERDUE
  SOCIAL_POST_PUBLISHED
  SOCIAL_POST_FAILED
  SOCIAL_APPROVAL_DECIDED
  SOCIAL_REVIEW_SUBMITTED
  SOCIAL_SENT_FOR_APPROVAL
  SOCIAL_POST_SCHEDULED
  SOCIAL_METRICS_SYNCED
  SOCIAL_ACCOUNT_EXPIRING
  SOCIAL_ACCOUNT_NEEDS_RECONNECT
  SOCIAL_CONTENT_CREATED
}

enum AutomationActionType {
  ASSIGN_LEAD
  CREATE_LEAD_TASK
  SEND_EMAIL
  NOTIFY_USER
  CREATE_CLIENT
  CREATE_PROJECT
  CREATE_PROJECT_TASKS
  SET_LEAD_STATUS
  ADD_TAG
}

enum RedirectType {
  PERMANENT_301
  FOUND_302
  TEMPORARY_307
  PERMANENT_308
}

enum SchemaType {
  NONE
  ORGANIZATION
  WEBSITE
  SERVICE
  LOCAL_BUSINESS
  ARTICLE
  FAQ_PAGE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ASSIGN
  STATUS_CHANGE
  SEND
  PUBLISH
  UNPUBLISH
  // A whole content table leaving the building, or arriving. The individual
  // writes an import makes are audited by the services doing them; these two
  // record the run itself, which is the thing nothing else would show.
  EXPORT
  IMPORT
  // Figures read back from an external platform — a post's daily metrics
  // snapshot. Recorded once per post per day, so the trail says a number
  // arrived and when, without repeating itself on a rerun.
  SYNC
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  name         String
  phone        String?
  type         UserType   @default(STAFF)
  status       UserStatus @default(INVITED)

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Non-null only for portal users. This column is the spine of client
  // isolation (CLAUDE.md 2 rule 3) — the session claim is derived from it.
  clientId String?
  client   Client? @relation("ClientPortalUsers", fields: [clientId], references: [id], onDelete: Cascade)

  avatarId String?
  avatar   Media?  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  lastLoginAt          DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  inviteToken          String?   @unique
  inviteExpires        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads      Lead[]                @relation("LeadAssignee")
  leadActivities     LeadActivity[]
  leadNotes          LeadNote[]
  leadTasks          LeadTask[]            @relation("LeadTaskAssignee")
  assignmentsFrom    LeadAssignment[]      @relation("LeadAssignmentFrom")
  assignmentsTo      LeadAssignment[]      @relation("LeadAssignmentTo")
  assignmentsMade    LeadAssignment[]      @relation("LeadAssignmentBy")
  ownedOpportunities Opportunity[]
  createdProposals   Proposal[]
  proposalRevisions  ProposalRevision[]
  ownedClients       Client[]              @relation("ClientOwner")
  clientContact      ClientContact[]
  clientMessages     ClientMessage[]       @relation("ClientMessageAuthor")
  managedProjects    Project[]
  assignedTasks      ProjectTask[]         @relation("ProjectTaskAssignee")
  projectComments    ProjectComment[]
  timeEntries        TimeEntry[]
  ownedContentItems  ContentCalendarItem[]
  approvalsRequested Approval[]            @relation("ApprovalRequestedBy")
  approvalsDecided   Approval[]            @relation("ApprovalDecidedBy")
  reviewsSubmitted   SocialInternalReview[] @relation("InternalReviewSubmittedBy")
  reviewsDecided     SocialInternalReview[] @relation("InternalReviewDecidedBy")
  socialReportsMade  SocialReport[]         @relation("SocialReportGeneratedBy")
  socialReportsSent  SocialReport[]         @relation("SocialReportPublishedBy")
  approvalVersions   ApprovalVersion[]
  ownedCampaigns     Campaign[]
  uploadedMedia      Media[]               @relation("MediaUploader")
  mediaVersions      MediaVersion[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  blogPosts          BlogPost[]
  pageVersions       PageVersion[]         @relation("PageVersionAuthor")

  socialAccountsConnected    SocialAccount[]           @relation("SocialAccountConnectedBy")
  socialPendingConnections   SocialPendingConnection[]
  socialBrandProfilesUpdated SocialBrandProfile[]      @relation("SocialBrandProfileUpdatedBy")
  socialStrategiesUpdated    SocialStrategy[]          @relation("SocialStrategyUpdatedBy")
  socialPublications         SocialPublication[]       @relation("SocialPublicationTriggeredBy")

  @@index([type, status])
  @@index([roleId])
  @@index([clientId])
  @@index([departmentId])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  label       String
  description String?
  // System roles are seeded and cannot be deleted through the admin UI.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // "leads.assign"
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Lead {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  company String?
  message String?

  budget   Decimal? @db.Decimal(14, 2)
  currency Currency @default(INR)

  status   LeadStatus @default(NEW)
  priority Priority   @default(MEDIUM)
  score    Int        @default(0)

  sourceId  String
  source    LeadSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  serviceId String?
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cityId    String?
  city      City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  popupId   String?
  popup     Popup?          @relation(fields: [popupId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Attribution is written server-side from cookies and headers, never from
  // the request body (docs/ARCHITECTURE.md 14.2).
  firstTouchId String?
  firstTouch   UTMTracking? @relation("LeadFirstTouch", fields: [firstTouchId], references: [id], onDelete: SetNull)
  lastTouchId  String?
  lastTouch    UTMTracking? @relation("LeadLastTouch", fields: [lastTouchId], references: [id], onDelete: SetNull)

  landingPath String?
  referrer    String?
  device      DeviceType?

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  convertedClientId String?
  convertedClient   Client?   @relation("LeadConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  activities    LeadActivity[]
  notes         LeadNote[]
  tasks         LeadTask[]
  assignments   LeadAssignment[]
  tags          LeadTag[]
  opportunities Opportunity[]
  proposals     Proposal[]
  popupEvents   PopupAnalytics[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([sourceId])
  @@index([cityId, serviceId])
  @@index([campaignId])
  @@index([popupId])
  @@index([packageId])
  @@index([convertedClientId])
  @@index([firstTouchId])
  @@index([lastTouchId])
  @@index([deletedAt])
  @@index([score])
}

model LeadSource {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  type      LeadSourceType
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  leads Lead[]

  @@index([isActive])
}

model LeadActivity {
  id      String           @id @default(cuid())
  leadId  String
  lead    Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type    LeadActivityType
  summary String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([actorId])
}

model LeadNote {
  id       String @id @default(cuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([authorId])
}

model LeadTask {
  id         String     @id @default(cuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   User       @relation("LeadTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  title      String
  detail     String?
  dueAt      DateTime
  status     TaskStatus @default(TODO)
  priority   Priority   @default(MEDIUM)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, dueAt])
  @@index([leadId])
  @@index([status, dueAt])
}

// History of every handoff. Lead.assignedToId is the current state; this is
// the trail (docs/ARCHITECTURE.md 6.2).
model LeadAssignment {
  id           String  @id @default(cuid())
  leadId       String
  lead         Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId   String?
  fromUser     User?   @relation("LeadAssignmentFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId     String
  toUser       User    @relation("LeadAssignmentTo", fields: [toUserId], references: [id], onDelete: Restrict)
  assignedById String
  assignedBy   User    @relation("LeadAssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([assignedById])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())

  leads LeadTag[]
  media MediaTag[]
}

/// Media tags, sharing `Tag` with the CRM rather than opening a second tag
/// vocabulary. One list of words the agency uses, joined per domain — the same
/// shape `LeadTag` already established.
model MediaTag {
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

model LeadTag {
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Content and local SEO
// ---------------------------------------------------------------------------

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  body             Json?
  icon             String?
  heroMediaId      String?
  heroMedia        Media?        @relation("ServiceHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  status           PublishStatus @default(DRAFT)
  order            Int           @default(0)

  seoId String? @unique
  seo   Seo?    @relation("ServiceSeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cityPages    ServiceCityPage[]
  packages     ServicePackage[]
  leads        Lead[]
  caseStudies  CaseStudy[]
  testimonials Testimonial[]
  faqs         FAQ[]
  projects     Project[]
  popupTargets PopupTarget[]
  popupEvents  PopupAnalytics[]
  catalogItems CatalogItem[]

  @@index([status, order])
  @@index([heroMediaId])
}

model City {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  state      String
  country    String  @default("India")
  latitude   Float?
  longitude  Float?
  population Int?
  isActive   Boolean @default(true)
  order      Int     @default(0)

  seoId String? @unique
  seo   Seo?    @relation("CitySeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicePages ServiceCityPage[]
  leads        Lead[]
  caseStudies  CaseStudy[]
  testimonials Testimonial[]
  faqs         FAQ[]
  popupTargets PopupTarget[]
  popupEvents  PopupAnalytics[]

  @@index([isActive, order])
}

// Service x City. Generated from the database — never hand-written pages.
// The unique-content columns below are what canPublish() inspects
// (docs/ARCHITECTURE.md 13); a page failing that check cannot leave DRAFT
// and is forced noindex.
model ServiceCityPage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cityId    String
  city      City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  localIntro    String?
  marketContext String?
  industries    Json?
  positioning   String?
  ctaHeading    String?
  ctaBody       String?

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  seoId String? @unique
  seo   Seo?    @relation("ServiceCityPageSeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs         FAQ[]
  popupTargets PopupTarget[]

  @@unique([serviceId, cityId])
  @@index([status])
  @@index([cityId, status])
}

model Page {
  id     String        @id @default(cuid())
  slug   String        @unique
  title  String
  status PublishStatus @default(DRAFT)

  /// Admin-facing label. The public `title` is a headline and is often not the
  /// clearest thing to scan a list of 200 pages by.
  internalName String?
  /// Short editorial note for the team. Never rendered publicly.
  description  String?

  /// Set the first time the page reaches PUBLISHED and kept thereafter, so
  /// unpublishing and republishing does not rewrite history.
  publishedAt DateTime?

  /// When this page should go live, and when it should come down.
  ///
  /// Stored in UTC like every other timestamp; the admin converts from the
  /// operator's own clock on the way in and back on the way out. A time in the
  /// past is not an error — it simply fires on the next run, which is what
  /// "publish it at nine" set at five past nine should do.
  ///
  /// `publishAt` is cleared once it fires, so a scheduled publish happens once.
  /// `unpublishAt` is kept, because a campaign page that is taken down and
  /// manually put back should still come down again at its end date unless
  /// someone changes it.
  publishAt   DateTime?
  unpublishAt DateTime?

  /// The template this page was made from, kept for the answer to "which bands
  /// may this page have". Nullable: pages predating templates, and pages made
  /// from none, are ordinary pages with no restriction.
  templateId String?
  template   PageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Editorial state. See PageWorkflow.
  workflow PageWorkflow @default(DRAFT)

  /// The reviewer's note from the last transition, shown to whoever picks the
  /// page up next. Cleared when the page moves back into review.
  reviewNote String?

  /// Soft delete. A page's slug is a live URL; hard-deleting one silently
  /// breaks inbound links and loses the section history behind it. Every read
  /// path filters on `deletedAt: null`.
  deletedAt DateTime?

  /// Shareable draft preview.
  ///
  /// Null means no link exists — the default, because an unlisted URL that
  /// serves unpublished content should be something someone opts into rather
  /// than something every page carries. Generated from a CSPRNG, rotatable,
  /// and revocable by setting it back to null. The route it serves is noindex
  /// and excluded from the sitemap.
  previewToken String? @unique

  seoId String? @unique
  seo   Seo?    @relation("PageSeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections PageSection[]
  versions PageVersion[]

  @@index([status])
  @@index([workflow])
  @@index([deletedAt])
  @@index([updatedAt])
  /// The scheduler's two queries: what is due to go up, and what is due to come
  /// down. Both filter on the timestamp and the status together.
  @@index([publishAt])
  @@index([unpublishAt])
  @@index([templateId])
}

/// A shape a new page starts in.
///
/// Three things, and each answers a question the page builder left open:
/// which bands a page of this kind starts with, which bands may be added to it
/// at all, and what its SEO should default to. A "service landing page" and a
/// "legal page" are not the same object with different words in them.
///
/// Templates are applied at creation and then let go: the page owns its
/// sections from that moment. Editing a template never reaches back into pages
/// already made from it — that would be a second, invisible way to change a
/// live page, and the builder is the only way there should be.
/// Who a section is for.
///
/// Modelled directly on `PopupTarget` (docs/ARCHITECTURE.md 12.6): the same
/// server-side, deterministic, inspectable shape, evaluated before render so a
/// band a visitor should not see never reaches their browser.
///
/// **A section with no rules is shown to everyone.** That is the opposite of a
/// popup, where no targets means never shown — and deliberately so: a popup
/// with nobody to show it to is a mistake, whereas a section with nobody named
/// is simply an ordinary section.
///
/// Several rules on one section are OR-ed, matching `targets.some(...)`. Within
/// one rule every field must match.
///
/// Only attributes this application genuinely knows are here: the device from
/// the user agent, new-versus-returning from the visitor cookie, and the UTM
/// and referrer values already captured for attribution. There is no visitor
/// city, because there is no geo-IP and inventing one would be a fabricated
/// audience (CLAUDE.md 5).
model SectionAudience {
  id        String      @id @default(cuid())
  sectionId String
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  visitorType VisitorType @default(ANY)
  device      DeviceType  @default(ANY)

  /// Matched against the visitor's last touch, case-insensitively and exactly.
  /// Null means "any".
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Substring match on the referring URL. Null means "any".
  referrerContains String?

  createdAt DateTime @default(now())

  @@index([sectionId])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  STOPPED
}

/// An A/B test on a page.
///
/// Assignment is **deterministic**, not stored: a visitor's variant is a hash
/// of their visitor id and the experiment's key, so the same person sees the
/// same thing on every visit without a lookup, and without a write on the read
/// path.
///
/// Exposures *are* stored, once per visitor, because a sample size cannot be
/// derived from anything else — and without a sample size a verdict is a guess
/// (CLAUDE.md 5). That is the one write this feature adds, and it is the data
/// the feature is fundamentally about.
model Experiment {
  id String @id @default(cuid())

  key  String @unique
  name String

  /// What this test is trying to find out. Recorded so the result is read
  /// against the question that was asked, rather than a question invented
  /// afterwards to fit the numbers.
  hypothesis String?

  status ExperimentStatus @default(DRAFT)

  startedAt DateTime?
  stoppedAt DateTime?

  variants  ExperimentVariant[]
  exposures ExperimentExposure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// One arm of an experiment.
model ExperimentVariant {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  /// Stable handle within the experiment, e.g. `control`, `b`.
  key  String
  name String

  /// Relative share of traffic. Two variants at 1 and 1 split evenly; 3 and 1
  /// sends three quarters to the first.
  weight Int @default(1)

  /// Bands that belong to this arm. A section with no variant is part of the
  /// page itself and is shown to everyone in the test.
  sections  PageSection[]
  exposures ExperimentExposure[]

  createdAt DateTime @default(now())

  @@unique([experimentId, key])
  @@index([experimentId])
}

/// That a visitor was shown an arm, recorded once.
///
/// The unique constraint is the whole point: a visitor counts once towards the
/// sample however many times they reload, so the denominator is people rather
/// than page views.
model ExperimentExposure {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  variantId String
  variant   ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  visitorId String

  createdAt DateTime @default(now())

  @@unique([experimentId, visitorId])
  @@index([variantId])
  @@index([visitorId])
}

model PageTemplate {
  id String @id @default(cuid())

  /// Stable handle, so a seed or a migration can name a template without
  /// knowing its cuid.
  key         String  @unique
  name        String
  description String?

  /// The bands a page starts with: an ordered array of `{ type, content }`,
  /// validated against the block schemas on save and migrated forward on use,
  /// exactly as a PageVersion snapshot is.
  sections Json

  /// Block types this template permits, as an array of strings. **Empty means
  /// every block**, which is what a general-purpose template wants; the
  /// restriction exists for the templates that need one, not as a default.
  allowedBlocks Json

  /// What the page's SEO starts as. Null leaves the site defaults to derive it,
  /// which is right for most pages.
  defaultSchemaType  SchemaType @default(NONE)
  defaultRobotsIndex Boolean    @default(true)

  /// Off, rather than deleted: a template withdrawn from the New page list
  /// should not take its own history with it.
  isActive Boolean @default(true)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]

  @@index([isActive, order])
}

model PageSection {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    String
  order   Int    @default(0)
  content Json

  /// Builder label, shown in the section outline. Falls back to the block's
  /// own name when unset.
  name String?

  /// Hide/Show in the builder. A hidden section stays in the page and keeps
  /// its position; it is simply not rendered publicly. Distinct from deleting.
  isVisible Boolean @default(true)

  /// Who this band is for. Empty means everyone — see SectionAudience.
  audiences SectionAudience[]

  /// The experiment arm this band belongs to, if any. A section with no variant
  /// is part of the page itself and is shown to everyone in the test.
  variantId String?
  variant   ExperimentVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// When set, this slot renders a ReusableSection instead of its own content.
  /// `type` and `content` are still populated: they hold the last resolved
  /// snapshot, so a reusable section that is deleted or unpublished degrades
  /// this one band to its last-known-good state rather than blanking the page
  /// (the same posture `parseSections` already takes towards bad CMS data).
  reusableSectionId String?
  reusableSection   ReusableSection? @relation(fields: [reusableSectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@index([reusableSectionId])
  @@index([variantId])
}

/// A section authored once and placed on many pages.
///
/// Phase 1 lays the foundation only: the model, the FK from PageSection and the
/// publish/global flags. Resolution, editing and the "used on N pages" view
/// arrive with the reusable-sections feature itself.
/// A snapshot of a page, taken so an edit can be undone.
///
/// Sections are edited in place — the builder writes straight to PageSection —
/// so without this there is no way back from a bad afternoon. A version is a
/// complete copy of what the page said, not a diff: a diff chain is only as
/// good as its weakest link, and restoring one is the moment you least want to
/// be replaying arithmetic.
///
/// Taken automatically on publish, and on demand from the editor. Never taken
/// on every save: a version per keystroke is a version list nobody reads.
model PageVersion {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Sequential per page, so a version can be referred to as "v4".
  version Int

  /// The page's own fields at the time, and every section in order. Stored as
  /// JSON rather than as rows: a restored version must reproduce what the page
  /// said even if a block type has since changed shape, and the migration
  /// ladder (lib/content/migrations.ts) brings it forward on the way back in.
  snapshot Json

  /// Why this version exists: "Published", "Before restore", or an editor's own
  /// words.
  reason String?

  createdById String?
  createdBy   User?    @relation("PageVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@index([createdById])
}

model ReusableSection {
  id String @id @default(cuid())

  /// Stable human-readable handle, e.g. `global-cta`. Lets a reusable section
  /// be referenced from a seed or a migration without knowing its cuid.
  key  String @unique
  name String

  type    String
  content Json

  status PublishStatus @default(DRAFT)

  /// A global section is one the site places automatically rather than one an
  /// editor drags onto a page. The flag exists now so the distinction is in the
  /// data model before anything depends on it.
  isGlobal Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usages PageSection[]

  @@index([status])
  @@index([isGlobal])
  @@index([deletedAt])
}

model BlogPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String?
  body    Json?

  coverId String?
  cover   Media?  @relation("BlogCover", fields: [coverId], references: [id], onDelete: SetNull)

  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  readingMinutes Int           @default(1)

  seoId String? @unique
  seo   Seo?    @relation("BlogPostSeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags BlogPostTag[]

  /// Social ideas repurposed from this article.
  socialContent ContentCalendarItem[] @relation("ContentFromBlogPost")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([coverId])
}

model BlogCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  seoId String? @unique
  seo   Seo?    @relation("BlogCategorySeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogTag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model CaseStudy {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  clientName String
  summary    String
  body       Json?

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  coverId   String?
  cover     Media?   @relation("CaseStudyCover", fields: [coverId], references: [id], onDelete: SetNull)

  status PublishStatus @default(DRAFT)

  seoId String? @unique
  seo   Seo?    @relation("CaseStudySeo", fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics CaseStudyMetric[]

  @@index([status])
  @@index([serviceId])
  @@index([cityId])
  @@index([coverId])
}

model CaseStudyMetric {
  id          String    @id @default(cuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  label       String
  value       String
  unit        String?
  order       Int       @default(0)

  @@index([caseStudyId, order])
}

model Testimonial {
  id         String  @id @default(cuid())
  authorName String
  authorRole String?
  company    String?
  quote      String
  rating     Int?

  avatarId  String?
  avatar    Media?   @relation("TestimonialAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  status PublishStatus @default(DRAFT)
  order  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@index([serviceId])
  @@index([cityId])
  @@index([avatarId])
}

// Attaches to exactly one owner. Nullable FKs rather than a polymorphic pair,
// for the same integrity reason as Seo; a CHECK constraint added in the Phase 5
// migration will enforce exactly-one-owner.
model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String

  serviceId         String?
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cityId            String?
  city              City?            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  serviceCityPageId String?
  serviceCityPage   ServiceCityPage? @relation(fields: [serviceCityPageId], references: [id], onDelete: Cascade)
  packageId         String?
  package           ServicePackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([cityId])
  @@index([serviceCityPageId])
  @@index([packageId])
  @@index([isActive, order])
}

