// Numbers are entered by staff or imported from a provider. Nothing else
// writes here — CLAUDE.md 2 rule 5 and 16 forbid fabricated campaign metrics,
// and `source` keeps provenance auditable rather than assumed.
model CampaignMetric {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  revenue     Decimal? @db.Decimal(14, 2)

  source MetricSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

model UTMTracking {
  id        String @id @default(cuid())
  visitorId String

  source   String?
  medium   String?
  campaign String?
  term     String?
  content  String?

  landingPath String?
  referrer    String?
  device      DeviceType       @default(DESKTOP)
  touch       AttributionTouch

  occurredAt DateTime @default(now())

  firstTouchLeads Lead[]           @relation("LeadFirstTouch")
  lastTouchLeads  Lead[]           @relation("LeadLastTouch")
  popupEvents     PopupAnalytics[]

  @@index([visitorId, occurredAt])
  @@index([source, medium])
  @@index([touch])
}

model Popup {
  id         String  @id @default(cuid())
  name       String
  title      String
  body       String?
  ctaLabel   String?
  ctaHref    String?
  // Field definitions for the capture form, validated server-side on submit.
  formFields Json?

  trigger      PopupTrigger   @default(TIME_DELAY)
  // Seconds for TIME_DELAY, percent for SCROLL_PERCENT, else null.
  triggerValue Int?
  frequency    PopupFrequency @default(ONCE_PER_SESSION)
  priority     Int            @default(0)

  isActive Boolean   @default(false)
  startsAt DateTime?
  endsAt   DateTime?

  mediaId String?
  media   Media?  @relation("PopupMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets   PopupTarget[]
  analytics PopupAnalytics[]
  leads     Lead[]

  @@index([isActive, priority])
  @@index([mediaId])
}

model PopupTarget {
  id      String          @id @default(cuid())
  popupId String
  popup   Popup           @relation(fields: [popupId], references: [id], onDelete: Cascade)
  type    PopupTargetType

  path              String?
  serviceId         String?
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cityId            String?
  city              City?            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  serviceCityPageId String?
  serviceCityPage   ServiceCityPage? @relation(fields: [serviceCityPageId], references: [id], onDelete: Cascade)
  packageId         String?
  package           ServicePackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  visitorType VisitorType @default(ANY)
  device      DeviceType  @default(ANY)

  createdAt DateTime @default(now())

  @@index([popupId])
  @@index([serviceId])
  @@index([cityId])
  @@index([serviceCityPageId])
  @@index([packageId])
}

model PopupAnalytics {
  id      String         @id @default(cuid())
  popupId String
  popup   Popup          @relation(fields: [popupId], references: [id], onDelete: Cascade)
  event   PopupEventType

  visitorId String
  path      String

  serviceId  String?
  service    Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cityId     String?
  city       City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmId      String?
  utm        UTMTracking? @relation(fields: [utmId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())

  @@index([popupId, event, occurredAt])
  @@index([visitorId])
  @@index([serviceId])
  @@index([cityId])
  @@index([campaignId])
  @@index([utmId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Invoice {
  id       String @id @default(cuid())
  number   String @unique
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  retainerId String?
  retainer   Retainer? @relation(fields: [retainerId], references: [id], onDelete: SetNull)

  status   InvoiceStatus @default(DRAFT)
  currency Currency      @default(INR)

  issuedAt DateTime @default(now())
  dueAt    DateTime

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  paidTotal     Decimal @default(0) @db.Decimal(14, 2)
  // Stored and recomputed inside the same transaction as every payment, so
  // overdue queries are an indexed scan rather than an aggregate over Payment.
  dueTotal      Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([deletedAt])
  @@index([projectId])
  @@index([contractId])
  @@index([retainerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?

  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  discountRate Decimal @default(0) @db.Decimal(6, 3)
  taxRate      Decimal @default(0) @db.Decimal(6, 3)
  lineTotal    Decimal @db.Decimal(14, 2)

  order Int @default(0)

  @@index([invoiceId, order])
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  amount   Decimal  @db.Decimal(14, 2)
  currency Currency @default(INR)

  gateway PaymentGateway @default(RAZORPAY)
  status  PaymentStatus  @default(PENDING)

  gatewayOrderId   String?
  // Unique constraints are how a replayed webhook fails to double-credit —
  // enforced by the database, not by logic that could race
  // (docs/ARCHITECTURE.md 6.7).
  gatewayPaymentId String? @unique
  gatewaySignature String?
  idempotencyKey   String  @unique

  rawPayload Json?
  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([clientId, status])
  @@index([gatewayOrderId])
}

model Retainer {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  name     String
  amount   Decimal  @db.Decimal(14, 2)
  currency Currency @default(INR)

  cycle  BillingCycle   @default(MONTHLY)
  status RetainerStatus @default(ACTIVE)

  startsAt      DateTime
  nextBillingAt DateTime
  endsAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([status, nextBillingAt])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Media {
  id  String @id @default(cuid())
  // Opaque object key generated server-side. Never derived from the client
  // filename (CLAUDE.md 11).
  key String @unique
  url String

  filename String
  mimeType String
  size     Int
  type     MediaType
  width    Int?
  height   Int?
  alt      String?
  checksum String?

  /// A human title, distinct from the filename. The filename is what landed in
  /// the bucket; this is what an editor calls the picture.
  title String?

  /// Default caption. Used where a block shows one and has none of its own, so
  /// a photo credit set once follows the image everywhere it appears.
  caption String?

  /// Internal notes — where the shot came from, what the licence is, who is in
  /// it. Never rendered publicly.
  description String?

  /// Focal point, as whole percentages of width and height (0-100).
  ///
  /// A cropped image loses its edges, and which edges matter is a property of
  /// the picture, not of the band it is placed in: a portrait needs its face
  /// kept whatever aspect ratio it is poured into. Null means centre, which is
  /// what every image did before this existed.
  focalX Int?
  focalY Int?

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions           MediaVersion[]
  userAvatars        User[]                @relation("UserAvatar")
  serviceHeroes      Service[]             @relation("ServiceHero")
  blogCovers         BlogPost[]            @relation("BlogCover")
  caseStudyCovers    CaseStudy[]           @relation("CaseStudyCover")
  testimonialAvatars Testimonial[]         @relation("TestimonialAvatar")
  clientLogos        Client[]              @relation("ClientLogo")
  contractDocs       Contract[]            @relation("ContractDocument")
  contentItems       ContentCalendarItem[] @relation("ContentItemMedia")
  approvalVersions   ApprovalVersion[]     @relation("ApprovalVersionMedia")
  popups             Popup[]               @relation("PopupMedia")
  seoOgImages        Seo[]                 @relation("SeoOgImage")
  seoTwitterImages   Seo[]                 @relation("SeoTwitterImage")

  tags MediaTag[]

  @@index([folderId])
  @@index([type])
  @@index([deletedAt])
  @@index([uploadedById])
}

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")
  path     String        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]

  @@index([parentId])
}

model MediaVersion {
  id      String @id @default(cuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  version Int
  key     String
  url     String
  size    Int

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@unique([mediaId, version])
  @@index([uploadedById])
}

model EmailTemplate {
  id        String           @id @default(cuid())
  key       EmailTemplateKey @unique
  name      String
  subject   String
  html      String
  text      String?
  // Declared substitution variables, for admin editing and validation.
  variables Json?
  isActive  Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id                String            @id @default(cuid())
  templateKey       EmailTemplateKey?
  to                String
  cc                String?
  subject           String
  status            EmailStatus       @default(QUEUED)
  error             String?
  providerMessageId String?

  /// The values the template was rendered with, so a retry sends the same mail
  /// rather than one full of unfilled placeholders.
  variables Json?

  entityType String?
  entityId   String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([to])
  @@index([entityType, entityId])
}

model Notification {
  id      String              @id @default(cuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel @default(IN_APP)

  title String
  body  String?
  href  String?

  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Automation {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers   AutomationTrigger[]
  conditions AutomationCondition[]
  actions    AutomationAction[]

  @@index([isActive, order])
}

model AutomationTrigger {
  id           String                @id @default(cuid())
  automationId String
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         AutomationTriggerType
  config       Json?

  @@index([automationId])
  @@index([type])
}

model AutomationCondition {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  field        String
  operator     String
  value        Json
  order        Int        @default(0)

  @@index([automationId, order])
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String
  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         AutomationActionType
  config       Json
  order        Int                  @default(0)

  @@index([automationId, order])
}

// Written inside the same transaction as the mutation it records, so an audit
// gap cannot outlive a successful write (docs/ARCHITECTURE.md 4.5).
model AuditLog {
  id      String      @id @default(cuid())
  actorId String?
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action  AuditAction

  entityType String
  entityId   String

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// One reusable SEO record. The owning entity holds a unique FK to it, so every
// link is a real foreign key with real cascade behaviour — never a polymorphic
// entityType/entityId pair (docs/ARCHITECTURE.md 4.4).
model Seo {
  id String @id @default(cuid())

  metaTitle       String?
  metaDescription String?
  canonical       String?

  /// The phrase this page is meant to rank for.
  ///
  /// One, deliberately. A page written for six keywords ranks for none, and
  /// the analyzer can only say something useful about presence and density if
  /// it knows which phrase to look for. Blank means the checks that need one
  /// are simply not run — an unanswered question, not a failure.
  targetKeyword String?

  ogTitle       String?
  ogDescription String?
  ogImageId     String?
  ogImage       Media?  @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  ogImageAlt    String?

  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?
  twitterImage       Media?  @relation("SeoTwitterImage", fields: [twitterImageId], references: [id], onDelete: SetNull)

  robotsIndex  Boolean    @default(true)
  robotsFollow Boolean    @default(true)
  schemaType   SchemaType @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service         Service?         @relation("ServiceSeo")
  city            City?            @relation("CitySeo")
  serviceCityPage ServiceCityPage? @relation("ServiceCityPageSeo")
  page            Page?            @relation("PageSeo")
  blogPost        BlogPost?        @relation("BlogPostSeo")
  blogCategory    BlogCategory?    @relation("BlogCategorySeo")
  caseStudy       CaseStudy?       @relation("CaseStudySeo")
  servicePackage  ServicePackage?  @relation("ServicePackageSeo")

  @@index([ogImageId])
  @@index([twitterImageId])
}

// Loop detection runs at write time, not request time — a cycle never reaches
// production data (docs/ARCHITECTURE.md 12.4).
model Redirect {
  id       String       @id @default(cuid())
  fromPath String       @unique
  toPath   String
  type     RedirectType @default(PERMANENT_301)
  isActive Boolean      @default(true)

  hits      Int       @default(0)
  lastHitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  group String @default("general")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// Non-secret configuration only. Credentials live in env and are read solely
// through lib/config (CLAUDE.md 2 rule 6).
/// Fixed-window rate limiting, shared across application instances.
///
/// In-process counters are correct for exactly one container: behind two, an
/// attacker gets the limit once per instance. The window lives here so the
/// limit is the limit however many instances are running (docs/ARCHITECTURE.md
/// 19 D9).
model RateLimitWindow {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model IntegrationSetting {
  id        String  @id @default(cuid())
  provider  String  @unique
  config    Json
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
