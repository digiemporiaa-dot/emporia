model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProjectTask?  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks ProjectTask[] @relation("TaskSubtasks")

  title       String
  description String?

  assigneeId String?
  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)
  dueAt    DateTime?

  // Hours worked/estimated, not money — Decimal for fractional precision.
  estimateHours Decimal? @db.Decimal(8, 2)

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencies ProjectTaskDependency[] @relation("DependentTask")
  dependents   ProjectTaskDependency[] @relation("DependsOnTask")
