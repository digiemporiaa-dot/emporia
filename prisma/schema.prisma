/// Editorial state, distinct from publication.
///
/// `status` answers "is this live"; this answers "is the draft ready". They are
/// separate fields because they are separate questions and separate
/// permissions: an editor moves a page through review, a publisher puts it on
/// the site. A page that has never been through review is DRAFT, which is also
/// what every page that predates this is.
enum PageWorkflow {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OpportunityStage {
  DISCOVERY
  SCOPING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProposalStatus {
