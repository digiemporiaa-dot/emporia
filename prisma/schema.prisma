/**
 * A message between a client and the agency.
 * Scoped by clientId, which is what the portal filters on. `fromClient` records
 * which side wrote it at the time of writing, rather than being re-derived from
 * the author's account type later.
 */
model ClientMessage {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation("ClientMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  fromClient Boolean
  body       String

  /// Set when the other side has read it, so both ends can show an unread count.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([authorId])
  @@index([clientId, fromClient, readAt])
}

model ClientContact {
  id       String @id @default(cuid())
