  // correctly at every call site.
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  channel ContentChannel
  title   String
  brief   String?
  stage   ContentStage   @default(IDEA)

  scheduledFor DateTime?
  publishedAt  DateTime?

