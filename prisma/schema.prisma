/// Reusable line items for quoting.
///
/// A package is a productised bundle; this is the à-la-carte catalogue a
/// proposal draws individual lines from ("Extra landing page", "Additional
/// campaign"). Prices are Decimal and are copied onto the proposal item at
/// quote time, so later catalogue edits never move a figure already quoted.
model CatalogItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// What one unit is: "month", "page", "campaign", "hour".
  unit        String  @default("unit")

  unitPrice Decimal  @db.Decimal(14, 2)
  currency  Currency @default(INR)
  taxRate   Decimal  @default(0) @db.Decimal(6, 3)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@index([serviceId])
}

model Opportunity {
  id       String  @id @default(cuid())
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  title       String
  value       Decimal          @db.Decimal(14, 2)
  currency    Currency         @default(INR)
  stage       OpportunityStage @default(DISCOVERY)
  // Percent, 0-100. Not money — a plain Int is correct here.
  probability Int              @default(0)

  expectedCloseAt DateTime?
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]

  @@index([stage])
  @@index([ownerId])
  @@index([leadId])
  @@index([clientId])
}

model Proposal {
  id            String       @id @default(cuid())
  number        String       @unique
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  title  String
  status ProposalStatus @default(DRAFT)

  currency      Currency @default(INR)
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal  @default(0) @db.Decimal(14, 2)
  total         Decimal  @default(0) @db.Decimal(14, 2)

  validUntil DateTime?
  sentAt     DateTime?
  viewedAt   DateTime?
  decidedAt  DateTime?
  version    Int       @default(1)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ProposalItem[]
  revisions ProposalRevision[]
  contracts Contract[]

  @@index([status])
  @@index([leadId])
  @@index([clientId])
  @@index([opportunityId])
  @@index([createdById])
}

model ProposalItem {
  id            String   @id @default(cuid())
  proposalId    String
  proposal      Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// Where this line came from, for reporting. The price is still copied,
  /// never referenced, so editing the catalogue cannot alter a sent quote.
  catalogItemId String?
  name          String
  description   String?

  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  discountRate Decimal @default(0) @db.Decimal(6, 3)
  taxRate      Decimal @default(0) @db.Decimal(6, 3)
  // Stored, not computed on read: money already quoted to a customer must not
  // shift when tax logic is edited (docs/ARCHITECTURE.md 6.4).
  lineTotal    Decimal @db.Decimal(14, 2)

  order Int @default(0)

  @@index([proposalId, order])
}

model ProposalRevision {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  // Full item set at the time of sending, so a superseded revision stays
  // readable exactly as it was sent.
  snapshot   Json

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([proposalId, version])
  @@index([createdById])
}

model Contract {
