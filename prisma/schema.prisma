// Emporia — digital marketing agency operating system.
// Design rationale for every choice here lives in docs/ARCHITECTURE.md.
//
// Conventions (docs/ARCHITECTURE.md 4):
//   - money            Decimal(14,2), never Float / Int paise
//   - rates            Decimal(6,3)
//   - quantities       Decimal(12,3)
//   - ids              cuid()
//   - soft delete      deletedAt on Lead, Client, Invoice, Media
//   - Seo              owner holds a unique FK; never polymorphic

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserType {
  STAFF
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  MARKETING_MANAGER
  CONTENT_MANAGER
  PROJECT_MANAGER
  STAFF
  /// Portal accounts. Holds no admin permission at all — see
  /// lib/auth/permissions.ts.
  CLIENT_USER
}

enum Currency {
  INR
  USD
  EUR
  GBP
  AED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSourceType {
  WEBSITE_FORM
  POPUP
  PHONE
  EMAIL
  REFERRAL
  ADS
  SOCIAL
  WALK_IN
  IMPORT
  OTHER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  EMAIL_SENT
  CALL_LOGGED
  MEETING_LOGGED
  PROPOSAL_SENT
  SCORE_CHANGED
  CONVERTED
}

/// Editorial state, distinct from publication.
///
/// `status` answers "is this live"; this answers "is the draft ready". They are
/// separate fields because they are separate questions and separate
/// permissions: an editor moves a page through review, a publisher puts it on
/// the site. A page that has never been through review is DRAFT, which is also
/// what every page that predates this is.
enum PageWorkflow {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OpportunityStage {
  DISCOVERY
  SCOPING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATION
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ClientStatus {
  ACTIVE
  ON_HOLD
  CHURNED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ContentStage {
  IDEA
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum ContentChannel {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  BLOG
  YOUTUBE
  EMAIL
  ADS
}

/// An agency-side review round on social content, before the client sees it.
enum InternalReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  /// Pulled back, or superseded because the content was edited while waiting.
  WITHDRAWN
}

enum ApprovalStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  /// Pulled back by the agency before the client decided. Distinct from
  /// rejected, which is the client's word, and from pending, which would leave
  /// the portal asking for a decision on something no longer being offered.
  WITHDRAWN
}

enum BillingType {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
  RETAINER
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  BANK_TRANSFER
  CASH
  CHEQUE
  UPI
  OTHER
}

enum RetainerStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CampaignPlatform {
  GOOGLE_ADS
  META_ADS
  LINKEDIN_ADS
  SEO
  EMAIL
  SOCIAL_ORGANIC
  OTHER
}

enum CampaignStatus {
  DRAFT
