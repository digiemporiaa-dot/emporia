  logo   Media?  @relation("ClientLogo", fields: [logoId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  status ClientStatus @default(ACTIVE)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  portalUsers              User[]                    @relation("ClientPortalUsers")
  contacts                 ClientContact[]
  convertedFrom            Lead[]                    @relation("LeadConversion")
  opportunities            Opportunity[]
  proposals                Proposal[]
  contracts                Contract[]
  projects                 Project[]
  campaigns                Campaign[]
  invoices                 Invoice[]
  payments                 Payment[]
  retainers                Retainer[]
  contentItems             ContentCalendarItem[]
  approvals                Approval[]
  messages                 ClientMessage[]
  socialAccounts           SocialAccount[]
  socialPendingConnections SocialPendingConnection[]
  socialBrandProfile       SocialBrandProfile?
  socialStrategy           SocialStrategy?
  contentPillars           ContentPillar[]
  socialPosts              SocialPost[]
  socialPublications       SocialPublication[]
  socialMetrics            SocialMetricSnapshot[]
  contentOccasions         ContentOccasion[]
  internalReviews          SocialInternalReview[]
  socialReports            SocialReport[]
  clientOccasions          ClientOccasion[]

