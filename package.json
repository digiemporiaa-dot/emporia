    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.38.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
